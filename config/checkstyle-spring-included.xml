<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

	<!-- Global Configuration -->

	<!-- Sets UTF-8 as the default character encoding for all Java source files -->
	<property name="charset" value="UTF-8" />
	<!-- Sets the number of spaces per tab character to 4 -->
	<property name="tabWidth" value="4" />


	<!--File-Level Rules-->
	<!-- Ensures that each file ends with a single newline character -->
	<module name="NewlineAtEndOfFile" />


	<!-- Disallows the use of tab characters; enforces spaces only -->
	<module name="FileTabCharacter">
		<property name="eachLine" value="true" />
	</module>

	<!-- Limits the maximum number of lines allowed in a file to 2000 -->
	<module name="FileLength">
		<property name="max" value="2000" />
	</module>

	<!-- Validates that source files are encoded in UTF-8 -->
	<!--	<module name="FileEncoding">
		<property name="encoding" value="UTF-8" />
	</module>-->

	<!-- Enforces a license or header comment at the top of every file -->
	<!--	<module name="Header">
		<property name="headerFile" value="checkstyle-header.txt" />
	</module>
-->

	<!--Line Length & Layout-->
	<!-- Limits lines to a maximum of 120 characters, excluding package and
	import lines -->
	<module name="LineLength">
		<property name="max" value="120" />
		<property name="ignorePattern" value="^package.*|^import.*" />
	</module>

	<!-- Tree-based checks -->
	<module name="TreeWalker">


		<!-- RegexpSinglelineJava must go here -->
		<module name="RegexpSinglelineJava">
			<property name="format" value="System\.out\.print" />
			<property name="message"
				value="Avoid using System.out.print; use a logger instead." />
			<property name="ignoreComments" value="true" />
		</module>

		<!-- Disallows printStackTrace calls -->
		<module name="RegexpSinglelineJava">
			<property name="format" value="printStackTrace\s*\(" />
			<property name="message"
				value="Use logger.error instead of printStackTrace." />
		</module>

		<!-- Naming conventions -->
		<!-- Enforces PascalCase naming for classes and interfaces -->
		<module name="TypeName" />

		<!-- Enforces camelCase naming for methods -->
		<module name="MethodName" />

		<!-- Enforces camelCase naming for method parameters -->
		<module name="ParameterName" />

		<!-- Enforces camelCase naming for local variables -->
		<module name="LocalVariableName" />

		<!-- Enforces camelCase naming for instance fields -->
		<module name="MemberName" />

		<!-- Enforces UPPER_SNAKE_CASE naming for constants -->
		<module name="ConstantName" />

		<!-- Enforces single-uppercase character naming for class type
		parameters -->
		<module name="ClassTypeParameterName" />

		<!-- Enforces lower.case.package.naming.convention for package
		declarations -->
		<module name="PackageName">
			<property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$" />
		</module>


		<!-- Import rules -->
		<!-- Disallows wildcard imports (e.g., import java.util.*) -->
		<module name="AvoidStarImport" />

		<!-- Flags unused imports -->
		<module name="UnusedImports" />

		<!-- Flags repeated imports of the same class -->
		<module name="RedundantImport" />

		<!-- Enforces ordered, separated, and case-sensitive import grouping -->
		<module name="ImportOrder">
			<property name="ordered" value="true" />
			<property name="separated" value="true" />
			<property name="caseSensitive" value="true" />
		</module>

		<!-- Braces & control structure -->
		<!-- Ensures that opening curly braces are on the correct line -->
		<module name="LeftCurly" />

		<!-- Ensures that closing curly braces are on the correct line -->
		<module name="RightCurly" />

		<!-- Requires braces even for single-statement control blocks -->
		<module name="NeedBraces" />

		<!-- Flags empty code blocks with no logic -->
		<module name="EmptyBlock" />

		<!-- Whitespace & formatting -->
		<!-- Ensures a space appears after tokens like commas and semicolons -->
		<module name="WhitespaceAfter" />

		<!-- Ensures space appears around operators (e.g., =, +, -) -->
		<module name="WhitespaceAround" />

		<!-- Disallows whitespace after specific tokens (e.g., method names) -->
		<module name="NoWhitespaceAfter" />

		<!-- Disallows whitespace before specific tokens -->
		<module name="NoWhitespaceBefore" />

		<!-- Ensures a space appears inside parentheses -->
		<module name="ParenPad">
			<property name="option" value="space" />
		</module>

		<!-- Ensures parameters are padded with appropriate spacing -->
		<module name="MethodParamPad" />

		<!-- Ensures proper use of whitespace in generics -->
		<module name="GenericWhitespace" />

		<!-- Enforces spacing around type casts -->
		<module name="TypecastParenPad" />

		<!-- Enforces separation with empty lines between class members -->
		<module name="EmptyLineSeparator" />


		<!-- Javadoc rules -->
		<!-- Requires class-level Javadoc -->
		<module name="JavadocType" />

		<!-- Requires method-level Javadoc -->
		<module name="JavadocMethod" />

		<!-- Requires field-level Javadoc -->
		<module name="JavadocVariable" />

		<!-- Enforces consistent use of Javadoc tags and formatting -->
		<module name="JavadocStyle" />

		<!-- Ensures that all Javadoc content starts on the correct line -->
		<module name="JavadocContentLocation" />

		<!-- Ensures paragraph structure inside Javadoc is clear and separated -->
		<module name="JavadocParagraph" />


		<!-- Modifiers & class structure -->
		<!-- Enforces standard Java modifier ordering (e.g., public static
		final) -->
		<module name="ModifierOrder" />

		<!-- Flags unnecessary modifiers (e.g., interface methods declared
		public) -->
		<module name="RedundantModifier" />

		<!-- Controls visibility levels; prevents overly permissive access -->
		<module name="VisibilityModifier" />

		<!-- Enforces standard declaration order of class elements -->
		<module name="DeclarationOrder" />

		<!-- Enforces one top-level class per file -->
		<module name="OneTopLevelClass" />

		<!-- Ensures filename matches public class name -->
		<module name="OuterTypeFilename" />


		<!-- Complexity -->
		<!-- Limits cyclomatic complexity (number of branches) in methods -->
		<module name="CyclomaticComplexity">
			<property name="max" value="10" />
		</module>

		<!-- Limits number of external classes used in a class -->
		<module name="ClassFanOutComplexity">
			<property name="max" value="20" />
		</module>

		<!-- Limits maximum nested if levels -->
		<module name="NestedIfDepth">
			<property name="max" value="3" />
		</module>

		<!-- Limits nested try blocks -->
		<module name="NestedTryDepth">
			<property name="max" value="3" />
		</module>

		<!-- Limits nested loops -->
		<module name="NestedForDepth">
			<property name="max" value="3" />
		</module>


		<!-- Limits method size in lines -->
		<module name="MethodLength">
			<property name="max" value="50" />
		</module>


		<!-- Logging / Forbidden APIs -->
		<!-- Disallows System.out.println usage -->
		<!--		<module name="RegexpSinglelineJava">
			<property name="format" value="System\.out\.println" />
			<property name="message"
				value="Use logger instead of System.out.println" />
		</module>-->


		<!-- Forbidden APIs-->
		<!-- Bans use of thread or reflection APIs -->
		<module name="IllegalImport">
			<property name="illegalPkgs"
				value="java.lang.Thread, java.lang.reflect, java.util.concurrent.Executors" />
		</module>

		<!-- Disallows use of Runtime.getRuntime() -->
		<!--		<module name="IllegalTokenText">
			<property name="tokens" value="LITERAL_SYSTEM" />
			<property name="format" value="Runtime\.getRuntime\(\)" />
			<property name="message" value="Avoid Runtime.getRuntime()." />
		</module>
		-->


		<!--  Exception Handling and Equality Contracts -->
		<!-- Disallows catch or throws of overly generic exceptions -->
		<module name="IllegalThrows">
			<property name="illegalClassNames"
				value="java.lang.Exception, java.lang.Throwable" />
		</module>

		<!-- Prevents catching generic exceptions -->
		<module name="IllegalCatch">
			<property name="illegalClassNames"
				value="java.lang.Exception, java.lang.Throwable" />
		</module>

		<!-- Requires that equals and hashCode are overridden together -->
		<module name="EqualsHashCode" />

		<!-- Prevents equals() with non-compatible types -->
		<module name="CovariantEquals" />


		<!-- Magic numbers -->
		<!-- Disallows numeric literals outside of allowed exceptions -->
		<module name="MagicNumber">
			<property name="ignoreNumbers" value="-1,0,1" />
			<property name="ignoreHashCodeMethod" value="true" />
		</module>


		<!--  Class Design Constraints -->
		<!-- Disallows instantiation of utility classes -->
		<module name="HideUtilityClassConstructor" />

		<!-- Flags classes that should be final or abstract -->
		<module name="DesignForExtension" />


		<!--  Arrays, Literals, and Miscellaneous -->
		<!-- Requires array brackets to be after the type (Java-style) -->
		<module name="ArrayTypeStyle" />

		<!-- Requires use of capital 'L' for long literals -->
		<module name="UpperEll" />


		<!-- Annotations -->
		<!-- Requires @Override annotations on overridden methods -->
		<module name="MissingOverride" />

		<!-- Enforces compact annotation style for single values -->
		<module name="AnnotationUseStyle">
			<property name="elementStyle" value="compact" />
		</module>

		<!-- Controls location of annotations on same/different lines -->
		<module name="AnnotationLocation">
			<property name="allowSamelineSingleParameterlessAnnotation"
				value="false" />
		</module>


		<!-- Comments -->
		<!-- Ensures proper indentation of block comments -->
		<module name="CommentsIndentation">
			<property name="tokens" value="BLOCK_COMMENT_BEGIN" />
		</module>

		<!-- Flags TODO and FIXME in comments -->
		<module name="TodoComment">
			<property name="format" value="TODO|FIXME" />
		</module>


		<!--  Dead or Redundant Code -->
		<!-- Flags redundant type casts -->
		<!--<module name="RedundantCast"/>-->

		<!-- Flags empty semicolon-only statements -->
		<module name="EmptyStatement" />

		<!-- Disallows multiple variable declarations on the same line -->
		<module name="MultipleVariableDeclarations" />

		<!-- Requires only one statement per line -->
		<module name="OneStatementPerLine" />

		<!-- Disallows unnecessary nested code blocks -->
		<module name="AvoidNestedBlocks" />

		<!-- Prevents unintentional switch fallthrough -->
		<module name="FallThrough" />

		<!-- Flags assignments within expressions (e.g., if (a = b)) -->
		<module name="InnerAssignment" />

		<!-- Enforces use of equals() instead of == for strings -->
		<module name="StringLiteralEquality" />

		<!-- Enforces simplification of boolean expressions -->
		<module name="SimplifyBooleanExpression" />
		<module name="SimplifyBooleanReturn" />
	</module>

	<!--Avoid Field Injection-->
	<module name="RegexpSinglelineJava">
		<property name="format" value="@Autowired\s+private" />
		<property name="message"
			value="Avoid field injection; use constructor injection" />
	</module>

	<!--Block EntityManager Use in Services-->
	<module name="Regexp">
		<property name="format" value=".*Service.*EntityManager.*" />
		<property name="message"
			value="Avoid using EntityManager directly in services" />
	</module>

	<!--Disallow use of if, for, or DB terms in controllers-->
	<module name="Regexp">
		<property name="format"
			value=".*Controller.*(if\s*\(|for\s*\(|EntityManager|JpaRepository)" />
		<property name="message"
			value="Avoid putting logic or persistence in controllers" />
	</module>


	<!--Disallow Manual Instantiation of Beans-->
	<module name="RegexpSinglelineJava">
		<property name="format" value="new\s+.*Service\s*\(" />
		<property name="message"
			value="Avoid manual instantiation; use dependency injection" />
	</module>


	<!--Prevent @Entity on abstract or interface-->
	<module name="Regexp">
		<property name="format" value="abstract\s+class\s+.*@Entity" />
		<property name="message" value="Entities must be concrete classes" />
	</module>


	<!--Disallow @Transactional on Controllers-->
	<module name="Regexp">
		<property name="format"
			value="@Transactional\s+public\s+class\s+.*Controller" />
		<property name="message"
			value="Do not use @Transactional in Controllers" />
	</module>


	<!--Disallow @Transactional in repository classes-->
	<module name="Regexp">
		<property name="format"
			value="@Transactional\s+public\s+class\s+.*Repository" />
		<property name="message"
			value="Repository methods should not manage transactions directly" />
	</module>


	<!--Spring Layer Naming & Structural Convention-->
	<module name="ClassName">
		<property name="format" value=".*(Controller|Service|Repository)$" />
	</module>


	<!--Avoid Business Logic in Controllers (Heuristic)-->
	<module name="Regexp">
		<property name="format" value=".*Controller.*if\s*\(.*\).*" />
		<property name="message" value="Move business logic out of controller" />
	</module>


	<!-- Prevent Misplaced Annotations -->
	<module name="Regexp">
		<property name="format" value="@Service\s+public\s+class\s+.*Controller" />
		<property name="message"
			value="Do not annotate controllers with @Service" />
	</module>


	<!--Disallow Abstract Entities-->
	<module name="Regexp">
		<property name="format" value="abstract\s+class\s+.*\s+@Entity" />
		<property name="message" value="Entities should not be abstract" />
	</module>


	<!--Enforce Transactional Boundaries on Services-->
	<module name="Regexp">
		<property name="format" value="public\s+class\s+.*Service" />
		<property name="message"
			value="Service classes should declare @Transactional boundaries" />
	</module>


	<!-- Prevent @Transactional on a controller-->
	<module name="Regexp">
		<property name="format"
			value="@Transactional\s+public\s+class\s+.*Controller" />
		<property name="message" value="Transactions should be in service layer" />
	</module>

	<!--Disallow Logic in Repositories-->
	<module name="Regexp">
		<property name="format" value=".*Repository.*if\s*\(" />
		<property name="message"
			value="Business logic not allowed in repository classes" />
	</module>

	<!--Prevent @Component on Repositories-->
	<module name="Regexp">
		<property name="format"
			value="@Component\s+public\s+class\s+.*Repository" />
		<property name="message"
			value="Repositories should use @Repository, not @Component" />
	</module>


	<!--Disallow @Value in Controllers-->
	<module name="Regexp">
		<property name="format" value="@Value\s+private\s+.*Controller" />
		<property name="message" value="Avoid using @Value inside controllers" />
	</module>

	<!--Bonus: Enforce Exception Naming-->
	<module name="ClassName">
		<property name="format" value=".*Exception$" />
	</module>

	<!--Disallow EntityManager in Services and Controllers-->
	<module name="Regexp">
		<property name="format" value="EntityManager" />
		<property name="message"
			value="Avoid using EntityManager directly; prefer repositories" />
	</module>


	<!--Enforce Configuration Class Naming-->
	<module name="ClassName">
		<property name="format" value=".*Config$" />
	</module>

	<!--Prevent Unannotated Spring Beans (Heuristic)-->
	<module name="Regexp">
		<property name="format" value="public\s+class\s+.*Service" />
		<property name="message"
			value="Service classes should be annotated with @Service" />
	</module>


</module>
